# Пример переменных окружения. Скопируйте в .env и подставьте свои ключи.
# Файл .env с реальными ключами в репозиторий не коммитим.

# Ключ Serper.dev (Google Search API). Обязателен для модуля поиска.
# Получить: https://serper.dev — тариф примерно $0.30–1 за 1000 запросов.
SERPER_API_KEY=

# Ключ Jina Reader (https://jina.ai/reader). Необязателен:
# без ключа r.jina.ai работает с базовыми лимитами, ключ их повышает.
JINA_API_KEY=
